{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 100,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "typescript": {
    "quoteStyle": "preferDouble",
    "semiColons": "always",
    "trailingCommas": "onlyMultiLine"
  },
  "json": {},
  "markdown": {
    "textWrap": "maintain",
    "associations": [
      "**/*.{md,mdx}"
    ]
  },
  "toml": {},
  "malva": {},
  "markup": {},
  "yaml": {},
  "excludes": [
    "**/node_modules",
    "dist",
    "artifacts",
    "coverage",
    "tests/fixtures/**",
    ".mise",
    "pnpm-lock.yaml",
    "mise.lock",
    "LICENSE",
    "CHANGELOG.md",
    ".changes/*.md",
    "docs/design/**",
    "assets/icons/mark-*.svg"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.26.0",
    "npm:@dprint/toml@0.9.0",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.6",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
